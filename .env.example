# App
APP_ENV=local
# 调试模式：true 时异常响应附带 exception/trace 堆栈（生产必须为 false）
APP_DEBUG=true
PORT=4300
# 基础服务地址（开发：http://localhost:4300；生产：https://api.xxx.com）
APP_URL=http://localhost:4300
# 应用统一时区（IANA 名称，影响日志显示、日志滚动边界与定时任务）
APP_TIMEZONE=Asia/Shanghai

# Database
DB_URL="postgresql://nestforge:nestforge@localhost:5432/nestforge?schema=public"

# Better Auth
BETTER_AUTH_SECRET=nestforge-better-auth-secret-key-32-chars!
BETTER_AUTH_URL=http://localhost:4300
# Passkey (WebAuthn, optional - defaults to BETTER_AUTH_URL host/origin)
PASSKEY_RP_ID=localhost
PASSKEY_ORIGIN=http://localhost:3000

# Redis
REDIS_URL=redis://localhost:6379

# Mail (Mailpit in dev: smtp://localhost:1025; Prod: smtp://user:pass@smtp.example.com:587)
MAIL_URL=smtp://localhost:1025
MAIL_FROM_ADDRESS=no-reply@nestforge.dev
MAIL_FROM_NAME=NestForge

# Storage (local | s3)
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage/uploads
# S3 DSN (optional, for s3/minio/garage/r2: s3://key:secret@endpoint:port/bucket?region=us-east-1&publicUrl=https://cdn.domain.com)
STORAGE_S3_URL=

# BullBoard (opcional; sem estas credenciais o painel não é montado)
BULL_BOARD_USER=
BULL_BOARD_PASSWORD=
LOG_VIEWER_USER=
LOG_VIEWER_PASSWORD=

# OAuth (opcional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Rate limit
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Upload
UPLOAD_MAX_FILE_SIZE_BYTES=10485760
UPLOAD_ALLOWED_MIME_TYPES=image/png,image/jpeg,image/webp
UPLOAD_ALLOWED_EXTENSIONS=.png,.jpg,.jpeg,.webp

# Worker
# 是否在主应用进程中内嵌运行 Worker（消费队列与定时任务）。单进程部署设为 true，独立 Worker 部署设为 false
WORKER_EMBEDDED=false
# 是否启用 BullMQ 队列异步处理媒体转码与缩略图衍生。默认 true
MEDIA_QUEUE_ENABLED=true
# 是否挂载 OpenAPI Spec 与 Scalar 接口文档（生产环境若需屏蔽文档可设为 false）
SWAGGER_ENABLED=true

# Realtime Broadcasting
# 广播驱动: local (内嵌 Socket.IO / SSE) 或 pusher (对接 Soketi / Pusher 独立长连接网关)
BROADCAST_DRIVER=local
# Pusher / Soketi DSN (optional): pusher://key:secret@host:port/appId?cluster=mt1&useTls=false
REALTIME_URL=
