# ── 1. 核心运行配置 (Core Configuration) ────────────────────────────────────

# 应用基础
APP_ENV=local
APP_DEBUG=true
PORT=4300
APP_URL=http://localhost:4300

# 数据库 (PostgreSQL DSN)：生产必须显式配置；本地留空则使用 postgresql://postgres:postgres@localhost:5432/nest-api
DB_URL="postgresql://postgres:postgres@localhost:5432/nest-api?schema=public"
# 主库连接池：上限 / 空闲回收 / 建连超时
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECT_TIMEOUT_MS=5000

# 缓存与队列 (Redis / Valkey)
REDIS_URL=redis://localhost:6379/0

# 官方认证：JWT 签名密钥（≥32 字符）与 TOTP 加密密钥（逗号分隔，每段 ≥32 字符）
# 生产必须显式配置，否则启动失败；本地可用 just cmd jwt:secret 生成
JWT_SECRET=
MFA_ENCRYPTION_KEYS=
# 幂等响应加密密钥（逗号分隔、最新在前，每个 ≥32 字符）。未配置则明文存储；开启后旧明文记录会读取失败直到过期
# 验证码摘要专用密钥（≥32 字符，openssl rand -base64 32）。生产必填；未配置时以 JWT_SECRET 做域分离派生
# OTP_HMAC_KEY=
# IDEMPOTENCY_KEYS=
# COOKIE_SECRET= # Cookie 签名密钥 (≥32 字符, 未配置则禁用框架签名 Cookie)

# 应用名（品牌唯一来源：日志 / OTel 服务名 / 邮件发件人 / 短信签名 / 2FA 发行方均引用）
APP_NAME=nest-api

# 邮件服务 (SMTP DSN)
# 邮件驱动：smtp（默认）/ file（写 .eml，不投递）/ resend（需 RESEND_API_KEY）
# 生产：smtp 需非 localhost 的 MAIL_URL，且发件地址不得为 example.com
MAIL_TRANSPORT=smtp
MAIL_URL=smtp://localhost:1025
# MAIL_DIRECTORY=storage/tmp/mail
# RESEND_API_KEY=

# 短信通道 (手机验证码，默认 smsbao)
# 启动期校验：选择 aliyun 必须配齐其余四项凭证；smsbao 只配一半会拒绝启动（全未配置视为未启用）
# SMS_PROVIDER=smsbao
# SMSBAO_USER=
# SMSBAO_PASSWORD=
# SMSBAO_CONTENT=【nest-api】您的验证码为 {code}，5 分钟内有效。
# 阿里云短信 (SMS_PROVIDER=aliyun)
# ALIYUN_SMS_ACCESS_KEY_ID=
# ALIYUN_SMS_ACCESS_KEY_SECRET=
# ALIYUN_SMS_SIGN_NAME=
# ALIYUN_SMS_TEMPLATE_CODE=
# SMS_TIMEOUT_MS=5000 # 单次发送超时 (毫秒，上限 30000)

# 对象存储 (S3 兼容驱动 / Garage / MinIO / Cloudflare R2，配置后自动推导 FILESYSTEM_DISK=s3)
# 示例: s3://key:secret@endpoint:port/bucket?region=us-east-1&publicUrl=https://cdn.domain.com
STORAGE_S3_URL=

# 实时长连接网关 (Centrifugo)：未配置则广播为空操作且就绪探针报 down
# 示例: centrifugo://api-key:token-secret@127.0.0.1:8000/api?tls=false
REALTIME_URL=
# Centrifugo Proxy 回调共享密钥 (≥16 字符，与 deploy/centrifugo/config.yaml 的 header 保持一致)
# 生产环境一旦配置 REALTIME_URL 即强制必填（缺失则启动失败）；本地开发留空表示不校验该头
CENTRIFUGO_PROXY_SECRET=
# 服务端调用 Centrifugo HTTP API 的单次上限 (毫秒，默认 5000，上限 30000)
# 须小于 HTTP_TIMEOUT_MS：出站预算必须为请求预算留出余量
# REALTIME_TIMEOUT_MS=5000

# 全文检索 (Meilisearch，未配置则降级使用 noop 空驱动)
# 示例: meilisearch://masterKey@localhost:7700
SEARCH_URL=

# 动态图像实时处理与 HMAC 安全签名 (imgproxy)
# 示例: imgproxy://key:salt@localhost:8080?publicUrl=http://localhost:8080
IMGPROXY_URL=

# 工业物联网与 MQTT 5.0 (Mosquitto / EMQX)
# 示例: mqtt://nestforge-api:password@localhost:1883?clientId=nest-api
MQTT_URL=
# 设备凭证表 (一机一密，格式: deviceId:secret，逗号分隔)
IOT_DEVICE_CREDENTIALS=
# 设备租户归属表 (格式: deviceId:tenantId，逗号分隔)。租户由服务端决定，请求体自报的 tenantId 会被忽略
IOT_DEVICE_TENANTS=
# IOT_JWT_SECRET= # 设备换票独立签名密钥 (≥32 字符)
# IOT_DEVICE_PEPPER= # 设备密钥胡椒值 (≥16 字符)；生产环境禁止留空或使用公开默认值

# 微信支付 v3 (直连商户，留空自动按凭证齐全度推导 real/mock)
# 生产环境若凭证不完整会拒绝启动；未接入支付时显式声明 WEPAY_ALLOW_MOCK=true 退让
# WEPAY_ALLOW_MOCK=false
# WEPAY_APPID=wx1234567890abcdef
# WEPAY_MCHID=1900000001
# WEPAY_SERIAL_NO=4A3B2C1D9E8F7A6B5C4D3E2F1A0B9C8D7E6F5A4B
# WEPAY_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkq...\n-----END PRIVATE KEY-----"
# WEPAY_APIV3_KEY=your-32-byte-apiv3-key-here
# WEPAY_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG...\n-----END PUBLIC KEY-----"
# WEPAY_PUBLIC_KEY_ID=PUB_KEY_ID_0000000000000000000000000000000000

# 微信小程序服务端 API (留空自动按凭证齐全度推导 real/mock)
# MINIPROGRAM_APPID=wx1234567890abcdef
# MINIPROGRAM_APPSECRET=0123456789abcdef0123456789abcdef

# ── 2. 可观测性 (OpenTelemetry Collector) ────────────────────────────────────
# 未配置 OTLP endpoint 时不初始化 SDK；配置后 traces + metrics 推送到 otel-collector
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_SERVICE_NAME=nestforge-api # 服务标识覆盖 (默认根据进程角色自动推导)
# OTEL_TRACES_SAMPLER=parentbased_always_on # 追踪采样器 (生产推荐 parentbased_traceidratio)
# OTEL_TRACES_SAMPLER_ARG=1.0 # 采样比率 (0.01 即 1%)
# OTEL_EXPORTER_OTLP_HEADERS= # 认证头 (key1=value1,key2=value2)

# ── 3. 高级扩展与调优参数 (Advanced Options) ────────────────────────────────
# LOG_LEVEL=info # 日志级别 (trace|debug|info|warn|error|fatal|silent)；本地调试可设 debug
# APP_TIMEZONE=Asia/Shanghai
# TRUSTED_ORIGINS=https://app.example.com # CSRF 跨域写请求额外放行来源 (逗号分隔)
# TRUST_PROXY=false # 反向代理信任策略：false|true|网关CIDR(逗号分隔)。默认不信任 X-Forwarded-For
# MAIL_FROM_ADDRESS=no-reply@example.com
# MAIL_FROM_NAME=nest-api
# STORAGE_LOCAL_ROOT=./storage/uploads
# HTTP_TIMEOUT_MS=15000
# THROTTLE_TTL=60
# THROTTLE_LIMIT=100
# THROTTLE_STORAGE=redis # redis (分布式共享计数) | memory (单机进程内)
# SHUTDOWN_TIMEOUT_MS=10000
# SHUTDOWN_DRAIN_DELAY_MS=0
# UPLOAD_MAX_FILE_SIZE_BYTES=10485760
# UPLOAD_ALLOWED_MIME_TYPES=image/png,image/jpeg,image/webp
# UPLOAD_ALLOWED_EXTENSIONS=.png,.jpg,.jpeg,.webp
# SWAGGER_ENABLED=true # OpenAPI 与 Scalar 文档
