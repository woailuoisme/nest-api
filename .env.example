# =============================================================================
# 1. 核心开箱配置区 (Core Configuration)
# 业务必须的环境特异性 DSN 与核心标识（推荐仅保留本区配置）
# =============================================================================

# App
APP_ENV=local
APP_DEBUG=true
PORT=4300
APP_URL=http://localhost:4300

# Database
DB_URL="postgresql://nestforge:nestforge@localhost:5432/nestforge?schema=public"

# Redis
REDIS_URL=redis://localhost:6379/0

# Better Auth
BETTER_AUTH_SECRET=nestforge-better-auth-secret-key-32-chars!

# 框架内置 Cookie 签名密钥 (≥32 字符)。未配置时不启用内置 Cookie 能力 (setCookie/@SignedCookies)
# COOKIE_SECRET=

# Mail
MAIL_URL=smtp://localhost:1025

# Storage (S3 / Garage / MinIO / Cloudflare R2)
# 若配置则自动推导 STORAGE_DRIVER=s3，未配置时默认自动降级使用 local 本地存储
# 示例: s3://key:secret@endpoint:port/bucket?region=us-east-1&publicUrl=https://cdn.domain.com
STORAGE_S3_URL=

# Realtime (Centrifugo)
# 默认广播驱动为 centrifugo；未配置 REALTIME_URL 时使用 local 驱动降级
# 示例: centrifugo://aef5a17a-fdeb-48aa-b2c1-d490c62ff950:768583f3-7205-4b36-aea3-32ca8dea4914@127.0.0.1:8000/api?tls=false
REALTIME_URL=

# Search (Meilisearch)
# 默认搜索驱动：未配置 SEARCH_URL 时自动使用 noop 空驱动降级；配置后自动推导为 meilisearch
# 示例: meilisearch://masterKey@localhost:7700
SEARCH_URL=

# Image Processing (imgproxy)
# 动态图像实时处理与 HMAC 安全签名服务
# 示例: imgproxy://9348e3a2b1c4d5e6f7a8b9c0d1e2f3a4:5678f1a2b3c4d5e6f7a8b9c0d1e2f3a4@localhost:8080?publicUrl=http://localhost:8080
IMGPROXY_URL=

# MQTT 5.0 (Mosquitto)
# 工业物联网通信与设备控制 DSN (支持 mqtt://, mqtts://, ws://, wss://)
# Broker 已强制账号密码鉴权（deploy/mosquitto/config/mosquitto.conf），必须携带凭据；
# 账号须先由 just mqtt-passwd 写入 deploy/mosquitto/config/credentials/password.txt
# 示例: mqtt://nestforge-api:password@localhost:1883?clientId=nest-forge&clean=true&keepalive=60
MQTT_URL=

# 设备接入凭证表 (一机一密，格式: deviceId:secret，多个以英文逗号分隔)
# 留空表示禁止设备换票 (POST /v1/iot/devices/token 一律 401)
# 示例: IOT_DEVICE_CREDENTIALS=plc-01:s3cr3t-abc123,cnc-001:s3cr3t-def456
IOT_DEVICE_CREDENTIALS=

# 设备接入 JWT 独立签名密钥 (≥32 字符，必须与 BETTER_AUTH_SECRET 域分离)
# 生成: openssl rand -base64 48；未配置时设备换票接口返回 503
# IOT_JWT_SECRET=

# 设备密钥校验用 HMAC 加固盐值 (Pepper，≥16 字符，生产环境务必显式配置并妥善保管)
# IOT_DEVICE_PEPPER=

# 设备接入 JWT 有效期 (秒)。默认 30 天；缩短有效期需设备侧配合静默续签
# IOT_TOKEN_TTL_SECONDS=2592000

# 微信支付 v3 (直连商户)
# 驱动模式留空时按凭证齐全度自动推导：齐全 → real，否则 → mock。
# 生产环境若凭证缺失会直接阻断启动（避免静默降级为 mock 造成资损），本地/CI 则自动降级为 mock。
# 示例（真实商户）：
# WEPAY_APPID=wx1234567890abcdef
# WEPAY_MCHID=1900000001
# WEPAY_SERIAL_NO=4A3B2C1D9E8F7A6B5C4D3E2F1A0B9C8D7E6F5A4B
# 商户 API 私钥：可内联（多行以 \n 转义）或改用 WEPAY_PRIVATE_KEY_PATH 指向文件
# WEPAY_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkq...\n-----END PRIVATE KEY-----"
# WEPAY_PRIVATE_KEY_PATH=certs/apiclient_key.pem
# APIv3 密钥（必须为 32 字节，用于回调解密与平台证书解密）
# WEPAY_APIV3_KEY=your-32-byte-apiv3-key-here
# 微信支付公钥（2024 年后新商户默认模式，配置后无需下载平台证书；与公钥 ID 成对配置）
# WEPAY_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG...\n-----END PUBLIC KEY-----"
# WEPAY_PUBLIC_KEY_ID=PUB_KEY_ID_0000000000000000000000000000000000
# 回调地址（单次下单可通过 notifyUrl 覆盖）
# WEPAY_NOTIFY_URL=https://api.example.com/v1/payments/wepay/notify

# 微信小程序服务端 API
# 驱动模式留空时按凭证齐全度自动推导：齐全 → real，否则 → mock。
# 生产环境若凭证缺失会直接阻断启动（避免线上静默返回假 openid / 假手机号 / 假小程序码），
# 本地/CI 则自动降级为 mock（确定性假数据，全链路可跑通）。
# 注意：AppSecret 是服务端专用密钥，严禁下发到前端或提交进版本库。
# 示例（真实小程序）：
# MINIPROGRAM_APPID=wx1234567890abcdef
# MINIPROGRAM_APPSECRET=0123456789abcdef0123456789abcdef

# =============================================================================
# 2. 高级微调与扩展区 (Advanced Tuning & Extensions)
# 默认均在 src/config/env.validation.ts 中提供生产级最佳默认值，按需取消注释覆盖
# =============================================================================

# --- 基础设置 ---
# 应用统一时区（IANA 名称，影响日志显示、日志滚动边界与定时任务）
# APP_TIMEZONE=Asia/Shanghai
# Better Auth 外部访问地址（默认自动级联 APP_URL）
# BETTER_AUTH_URL=http://localhost:4300

# --- 认证扩展 ---
# Passkey (WebAuthn, 默认继承 BETTER_AUTH_URL 的主机名与源)
# PASSKEY_RP_ID=localhost
# PASSKEY_ORIGIN=http://localhost:3000

# --- 跨站请求防护 (CSRF, 基于 Fetch Metadata) ---
# 额外信任的浏览器来源 (逗号分隔)。同源请求与 http(s) 服务端调用无需配置；
# 独立域名的前端 (SPA) 需在此列出自身来源，否则跨域写请求将被 403 拒绝。
# APP_URL / BETTER_AUTH_URL / PASSKEY_ORIGIN 会自动纳入信任列表。
# TRUSTED_ORIGINS=https://app.example.com,https://admin.example.com
# Google OAuth 凭据
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- 邮件发件人 ---
# MAIL_FROM_ADDRESS=no-reply@nestforge.dev
# MAIL_FROM_NAME=NestForge

# --- 存储微调 ---
# 存储驱动显式指定 (local | s3，通常无需配置，存在 STORAGE_S3_URL 时自动推导为 s3)
# STORAGE_DRIVER=local
# 本地存储根目录
# STORAGE_LOCAL_ROOT=./storage/uploads

# --- 接口与限流 ---
# 全局 HTTP 请求超时时间（毫秒，默认 15000ms 即 15 秒）
# HTTP_TIMEOUT_MS=15000
# 是否启用响应压缩（服务端支持 br/gzip/deflate，Node 支持 zstd 时一并参与协商，默认 true）
# COMPRESSION_ENABLED=true
# 响应压缩体积阈值（字节，默认 1024）：小于该值的响应不压缩，避免 CPU 负收益
# COMPRESSION_THRESHOLD_BYTES=1024
# 限流窗口时长（秒）
# THROTTLE_TTL=60
# 限流最大请求次数
# THROTTLE_LIMIT=100
# 限流计数后端：redis（默认，跨副本共享计数，Redis 故障时降级为进程内计数）| memory（仅进程内，本地无 Redis 时使用）
# THROTTLE_STORAGE=redis

# --- 优雅停机与弹性治理 ---
# 优雅停机硬超时保底时间（毫秒，默认 10000ms 即 10 秒）
# SHUTDOWN_TIMEOUT_MS=10000
# 优雅停机下线缓冲等待时间（毫秒，收到停机信号后等待网关/K8s摘流，默认 0ms，生产推荐 2000~5000ms）
# SHUTDOWN_DRAIN_DELAY_MS=0

# --- 上传限制 ---
# 单文件最大字节数（默认 10MB）
# UPLOAD_MAX_FILE_SIZE_BYTES=10485760
# 允许的 MIME 类型（逗号分隔）
# UPLOAD_ALLOWED_MIME_TYPES=image/png,image/jpeg,image/webp
# 允许的文件扩展名（逗号分隔）
# UPLOAD_ALLOWED_EXTENSIONS=.png,.jpg,.jpeg,.webp

# --- 运行模式 ---
# 是否在主应用进程中内嵌运行 Worker（消费队列与定时任务）。单进程部署设为 true，独立 Worker 部署设为 false
# WORKER_EMBEDDED=false
# 是否启用 BullMQ 队列异步处理媒体转码与缩略图衍生。默认 true
# MEDIA_QUEUE_ENABLED=true
# 是否挂载 OpenAPI Spec 与 Scalar 接口文档（生产环境若需屏蔽文档可显式设为 false）
# SWAGGER_ENABLED=true

# --- 广播与长连接 ---
# 广播驱动: centrifugo (默认推荐，对接独立 Centrifugo 网关) 或 local (内嵌 SSE/Socket.IO)
# BROADCAST_DRIVER=centrifugo
# 客户端外部 Centrifugo 连接端点（默认基于 REALTIME_URL 自动推导，如反向代理需重写可显式配置）
# CENTRIFUGO_PUBLIC_WS_URL=ws://127.0.0.1:8000/connection/websocket
# CENTRIFUGO_PUBLIC_SSE_URL=http://127.0.0.1:8000/connection/sse

# --- 物联网模拟器 ---
# 是否在本地/测试环境启用工业设备模拟响应器（Simulated PLC Agent）。生产环境严禁开启
# IOT_SIMULATED_DEVICE_ENABLED=false

# --- 微信支付微调 ---
# 微信支付 API 基址（默认 https://api.mch.weixin.qq.com）
# WEPAY_API_BASE=https://api.mch.weixin.qq.com
# 微信支付接口请求超时（毫秒，默认 15000ms）。独立于 HTTP_TIMEOUT_MS
# WEPAY_TIMEOUT_MS=15000

# --- 微信小程序微调 ---
# 小程序 API 基址（默认 https://api.weixin.qq.com）
# MINIPROGRAM_API_BASE=https://api.weixin.qq.com
# 小程序接口请求超时（毫秒，默认 10000ms）。同步轻请求，独立于 HTTP_TIMEOUT_MS
# MINIPROGRAM_TIMEOUT_MS=10000
# access_token 提前续期窗口（秒，默认 300）。官方普通模式下亦提前 5 分钟更新凭证，默认与之对齐
# MINIPROGRAM_ACCESS_TOKEN_SAFETY_WINDOW_SECONDS=300

# --- 控制台凭据 (未配置则不挂载控制台) ---
# BULL_BOARD_USER=
# BULL_BOARD_PASSWORD=
# LOG_VIEWER_USER=
# LOG_VIEWER_PASSWORD=

# 是否启用分布式链路追踪。默认 false
# 服务名称标识
# OTLP HTTP 导出端点（直连本地 Tempo）

