<mjml>
  <mj-head>
    <mj-title>Welcome to NestForge</mj-title>
    <mj-attributes>
      <mj-all font-family="'Helvetica Neue', Helvetica, Arial, sans-serif" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#F9FAFB">
    <mj-include path="./partials/header.mjml" />
    <mj-section background-color="#FFFFFF" border-radius="8px" padding="24px">
      <mj-column>
        <mj-text font-size="20px" font-weight="bold" color="#1F2937">Welcome to NestForge</mj-text>
        <mj-text font-size="14px" color="#4B5563" line-height="1.6">
          Hi {{ name }}, your account has been created! Click the button below to log in and get started:
        </mj-text>
        <mj-button
          background-color="#4F46E5"
          color="#FFFFFF"
          href="{{{link}}}"
          border-radius="6px"
          font-size="14px"
          padding="12px 24px"
        >
          Log in now
        </mj-button>
        <mj-text font-size="12px" color="#9CA3AF" line-height="1.6">
          If you didn't sign up for this account, please ignore this email.
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-include path="./partials/footer.mjml" />
  </mj-body>
</mjml>
