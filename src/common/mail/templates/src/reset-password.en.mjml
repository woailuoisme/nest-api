<mjml>
  <mj-head>
    <mj-title>Reset your password</mj-title>
    <mj-attributes>
      <mj-all font-family="'Helvetica Neue', Helvetica, Arial, sans-serif" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#F9FAFB">
    <mj-include path="./partials/header.mjml" />
    <mj-section background-color="#FFFFFF" border-radius="8px" padding="24px">
      <mj-column>
        <mj-text font-size="20px" font-weight="bold" color="#1F2937">Reset your password</mj-text>
        <mj-text font-size="14px" color="#4B5563" line-height="1.6">
          Hi {{name}}, we received a request to reset your password. Click the button below to set a new one:
        </mj-text>
        <mj-button background-color="#4F46E5" color="#FFFFFF" href="{{{link}}}" border-radius="6px" font-size="14px" padding="12px 24px">
          Reset password
        </mj-button>
        <mj-text font-size="12px" color="#9CA3AF" line-height="1.6">
          Button not working? Copy and paste this link into your browser:
        </mj-text>
        <mj-text font-size="12px" color="#4F46E5" line-height="1.6">{{{link}}}</mj-text>
        <mj-text font-size="12px" color="#9CA3AF" line-height="1.6">
          This link expires in 1 hour. If you didn't request this, please ignore this email — your password won't change.
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-include path="./partials/footer.mjml" />
  </mj-body>
</mjml>
