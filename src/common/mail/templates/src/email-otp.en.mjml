<mjml>
  <mj-head>
    <mj-title>Your sign-in code</mj-title>
    <mj-attributes>
      <mj-all font-family="'Helvetica Neue', Helvetica, Arial, sans-serif" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#F9FAFB">
    <mj-include path="./partials/header.mjml" />
    <mj-section background-color="#FFFFFF" border-radius="8px" padding="24px">
      <mj-column>
        <mj-text font-size="20px" font-weight="bold" color="#1F2937">Your sign-in code</mj-text>
        <mj-text font-size="14px" color="#4B5563" line-height="1.6"> Hi {{ name }}, use this code to sign in: </mj-text>
        <mj-text font-size="32px" font-weight="bold" color="#4F46E5" letter-spacing="6px" align="center">
          {{ code }}
        </mj-text>
        <mj-text font-size="12px" color="#9CA3AF" line-height="1.6">
          The code expires in 5 minutes. Never share it. If this wasn't you, ignore this email.
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-include path="./partials/footer.mjml" />
  </mj-body>
</mjml>
