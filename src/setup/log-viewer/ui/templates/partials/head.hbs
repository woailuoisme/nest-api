<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{#if title}}{{title}}{{else}}NestForge Web Log Viewer{{/if}}</title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%2358a6ff' stroke-width='2'><path d='M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z'/><path d='M6 6h10'/><path d='M6 10h10'/></svg>" />
  
  <!-- 100% 离线自包含 tw-animate CSS -->
  {{#if twAnimateCssContent}}
  <style>
{{{twAnimateCssContent}}}
  </style>
  {{/if}}

  <!-- 100% 离线自包含核心样式 (滚动条、JSON高亮、检索高亮、x-cloak) -->
  {{#if cssContent}}
  <style>
{{{cssContent}}}
  </style>
  {{/if}}

  <!-- 防闪烁主题预初始化 -->
  <script>
    (function() {
      const saved = localStorage.getItem('nf_log_viewer_theme');
      const isDark = saved ? saved === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
      if (isDark) {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    })();
  </script>

  <!-- 100% 离线自包含 Tailwind CSS 浏览器版 JIT 运行时 -->
  {{#if tailwindJsContent}}
  <script>
{{{tailwindJsContent}}}
  </script>
  {{/if}}

</head>

