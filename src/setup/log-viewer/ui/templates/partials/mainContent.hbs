<main class="flex-1 flex flex-col overflow-hidden bg-white dark:bg-[#0d1117] transition-colors">
  <!-- 过滤与操作控制工具栏 -->
  <div class="p-3.5 border-b border-slate-200 dark:border-[#30363d] bg-white/95 dark:bg-[#161b22]/95 flex flex-wrap items-center justify-between gap-3 transition-colors text-sm shrink-0">
    
    <!-- 左侧：快速级别胶囊标签 (Pills) + 下拉 + 全文搜索 -->
    <div class="flex flex-wrap items-center gap-2 flex-1 min-w-[320px]">
      
      <!-- 快速级别胶囊标签 (Quick Level Pills) -->
      <div class="flex items-center gap-1.5 flex-wrap">
        <template x-for="lvl in availableLevels" :key="lvl.name">
          <button @click="toggleSingleLevel(lvl.name)"
                  @contextmenu.prevent="toggleLevel(lvl.name)"
                  :class="selectedLevels.includes(lvl.name) 
                    ? lvl.bgClass + ' font-semibold border shadow-sm' 
                    : 'bg-slate-100 dark:bg-[#21262d] border-transparent text-slate-400 dark:text-[#7d8590] hover:text-slate-700 dark:hover:text-[#c9d1d9] border'"
                  class="px-2.5 py-1 rounded-lg text-xs transition flex items-center space-x-1.5"
                  :title="'左键点击单独筛选 ' + lvl.label + '，右键点击切换多选'">
            <span class="w-1.5 h-1.5 rounded-full"
                  :class="{
                    'bg-rose-500 dark:bg-[#f85149]': lvl.name === 'fatal' || lvl.name === 'error',
                    'bg-amber-500 dark:bg-[#d29922]': lvl.name === 'warn',
                    'bg-sky-500 dark:bg-[#58a6ff]': lvl.name === 'info',
                    'bg-purple-500 dark:bg-[#d2a8ff]': lvl.name === 'debug',
                    'bg-slate-400 dark:bg-[#7d8590]': lvl.name === 'trace'
                  }"></span>
            <span x-text="lvl.shortLabel"></span>
            <span class="text-[11px] opacity-75 font-mono" x-text="meta.countByLevel[lvl.name] || 0"></span>
          </button>
        </template>
      </div>

      <!-- 级别多选下拉 (精细控制) -->
      <div class="relative" x-data="{ openLevelDropdown: false }">
        <button @click="openLevelDropdown = !openLevelDropdown"
                class="flex items-center space-x-1.5 px-2.5 py-1.5 rounded-lg border border-slate-300 dark:border-[#30363d] bg-white dark:bg-[#21262d] hover:bg-slate-50 dark:hover:bg-[#30363d] text-xs text-slate-700 dark:text-[#c9d1d9] transition font-medium shadow-sm"
                title="精细选择过滤级别">
          {{{icon "layers" class="w-3.5 h-3.5 text-sky-500 dark:text-[#58a6ff]"}}}
          <span x-text="selectedLevelsSummary"></span>
          {{{icon "chevron-down" class="w-3 h-3 text-slate-400 dark:text-[#7d8590]"}}}
        </button>

        <!-- 级别多选弹出框 -->
        <div x-show="openLevelDropdown" @click.outside="openLevelDropdown = false" x-cloak
             class="absolute left-0 mt-1.5 w-64 bg-white dark:bg-[#161b22] border border-slate-200 dark:border-[#30363d] rounded-xl shadow-2xl p-3.5 z-30 space-y-2 text-sm transition-colors animate-in fade-in zoom-in-95 duration-100">
          <div class="flex items-center justify-between pb-2 border-b border-slate-100 dark:border-[#21262d] text-xs text-slate-500 dark:text-[#7d8590]">
            <span class="font-semibold uppercase tracking-wider text-slate-700 dark:text-[#c9d1d9]">级别多选过滤</span>
            <div class="space-x-2">
              <button @click="selectAllLevels()" class="text-sky-600 dark:text-[#58a6ff] hover:underline">全选</button>
              <button @click="deselectAllLevels()" class="text-slate-500 dark:text-[#7d8590] hover:underline">清空</button>
            </div>
          </div>

          <div class="space-y-1">
            <template x-for="lvl in availableLevels" :key="lvl.name">
              <label class="flex items-center justify-between p-2 rounded hover:bg-slate-100 dark:hover:bg-[#21262d] cursor-pointer transition">
                <div class="flex items-center space-x-2.5">
                  <input type="checkbox" :value="lvl.name" x-model="selectedLevels" @change="onFilterChange()"
                         class="rounded border-slate-300 dark:border-[#30363d] bg-white dark:bg-[#0d1117] text-sky-500 dark:text-[#1f6feb] focus:ring-0">
                  <span class="font-medium text-sm" :class="lvl.textColor" x-text="lvl.label"></span>
                </div>
                <span class="text-xs font-mono px-2 py-0.5 rounded bg-slate-100 dark:bg-[#21262d] text-slate-600 dark:text-[#7d8590]"
                      x-text="meta.countByLevel[lvl.name] || 0"></span>
              </label>
            </template>
          </div>
        </div>
      </div>

      <!-- 全文检索输入框 -->
      <div class="relative flex-1 min-w-[200px]">
        <span class="absolute left-3.5 top-2.5 pointer-events-none text-slate-400 dark:text-[#7d8590]">
          {{{icon "search" class="w-4 h-4"}}}
        </span>
        <input type="text" id="searchInput" x-model.debounce.300ms="searchKeyword" @input="onFilterChange()"
               :placeholder="'在 ' + selectedFile + ' 中搜索 (支持 Msg, ReqId, Context, 堆栈)...'"
               class="w-full bg-white dark:bg-[#0d1117] text-sm text-slate-900 dark:text-[#e6edf3] placeholder-slate-400 dark:placeholder-[#7d8590] pl-10 pr-10 py-1.5 rounded-lg border border-slate-300 dark:border-[#30363d] focus:outline-none focus:border-sky-500 focus:dark:border-[#58a6ff] transition shadow-sm font-sans">
        
        <div class="absolute right-2.5 top-2 flex items-center">
          <button x-show="searchKeyword" @click="searchKeyword = ''; onFilterChange()"
                  class="text-slate-400 dark:text-[#7d8590] hover:text-slate-600 dark:hover:text-[#e6edf3] p-0.5"
                  title="清空搜索词">
            {{{icon "x" class="w-3.5 h-3.5"}}}
          </button>
        </div>
      </div>
    </div>

    <!-- 右侧操作栏：实时监听、排序、每页行数、轮询 -->
    <div class="flex items-center space-x-2 text-sm">
      <!-- 实时监听 (Live Stream SSE) 开关 -->
      <button @click="toggleLiveStream()"
              :class="liveStreamActive 
                ? 'bg-emerald-50 dark:bg-[#238636]/15 text-emerald-700 dark:text-[#3fb950] border-emerald-300 dark:border-[#238636]/40 shadow-sm' 
                : 'bg-white dark:bg-[#21262d] text-slate-600 dark:text-[#7d8590] border-slate-300 dark:border-[#30363d] hover:text-slate-900 dark:hover:text-[#c9d1d9]'"
              class="flex items-center space-x-2 px-3 py-1.5 rounded-lg border text-xs font-semibold transition shadow-sm"
              :title="liveStreamActive ? '点击停止实时监听' : '点击开启 SSE 实时监听'">
        <span class="relative flex h-2 w-2">
          <span x-show="liveStreamActive" class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 dark:bg-[#3fb950] opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2" :class="liveStreamActive ? 'bg-emerald-500 dark:bg-[#3fb950]' : 'bg-slate-400 dark:bg-[#7d8590]'"></span>
        </span>
        <span x-text="liveStreamActive ? '实时追踪中' : '实时追踪'"></span>
      </button>

      <!-- 排序方向 -->
      <select x-model="direction" @change="fetchEntries(false)"
              class="bg-white dark:bg-[#21262d] border border-slate-300 dark:border-[#30363d] rounded-lg px-2.5 py-1.5 text-xs text-slate-700 dark:text-[#c9d1d9] focus:outline-none focus:border-sky-500 focus:dark:border-[#58a6ff] shadow-sm font-medium">
        <option value="desc">最新优先 (Newest)</option>
        <option value="asc">最早优先 (Oldest)</option>
      </select>

      <!-- 每页条数 -->
      <select x-model="perPage" @change="fetchEntries(false)"
              class="bg-white dark:bg-[#21262d] border border-slate-300 dark:border-[#30363d] rounded-lg px-2.5 py-1.5 text-xs text-slate-700 dark:text-[#c9d1d9] focus:outline-none focus:border-sky-500 focus:dark:border-[#58a6ff] shadow-sm font-medium">
        <option value="25">25 条/页</option>
        <option value="50">50 条/页</option>
        <option value="100">100 条/页</option>
        <option value="250">250 条/页</option>
      </select>

      <!-- 自动轮询下拉 -->
      <select x-model="pollingInterval" @change="setupPolling()"
              class="bg-white dark:bg-[#21262d] border border-slate-300 dark:border-[#30363d] rounded-lg px-2.5 py-1.5 text-xs text-slate-700 dark:text-[#c9d1d9] focus:outline-none focus:border-sky-500 focus:dark:border-[#58a6ff] shadow-sm font-medium">
        <option value="0">轮询: 关</option>
        <option value="3">3秒轮询</option>
        <option value="5">5秒轮询</option>
        <option value="10">10秒轮询</option>
      </select>

      <!-- 换行切换 (Wrap Toggle) -->
      <button @click="toggleWrap()"
              :class="wrapLines 
                ? 'bg-sky-50 dark:bg-[#1f6feb]/15 text-sky-700 dark:text-[#58a6ff] border-sky-300 dark:border-[#388bfd]/40 shadow-sm' 
                : 'bg-white dark:bg-[#21262d] text-slate-600 dark:text-[#7d8590] border-slate-300 dark:border-[#30363d] hover:text-slate-900 dark:hover:text-[#c9d1d9]'"
              class="flex items-center space-x-1.5 px-2.5 py-1.5 rounded-lg border text-xs font-semibold transition shadow-sm"
              :title="wrapLines ? '当前: 完整换行模式 (点击切换为单行截断)' : '当前: 单行紧凑模式 (点击切换为完整换行)'">
        {{{icon "wrap-text" class="w-3.5 h-3.5"}}}
        <span x-text="wrapLines ? '换行: 开' : '换行: 关'"></span>
      </button>
    </div>
  </div>

  <!-- 主日志表格容器 -->
  <div id="logTableContainer" class="flex-1 overflow-y-auto relative">
    <!-- 加载状态 -->
    <div x-show="loading && items.length === 0" class="flex flex-col items-center justify-center h-64 space-y-3">
      {{{icon "loader-2" class="w-9 h-9 text-sky-500 dark:text-[#58a6ff] animate-spin"}}}
      <span class="text-sm text-slate-500 dark:text-[#7d8590]">正在解析并检索日志流...</span>
    </div>

    <!-- 空状态 -->
    <div x-show="!loading && items.length === 0" class="flex flex-col items-center justify-center h-64 space-y-2 text-slate-400 dark:text-[#7d8590]">
      {{{icon "inbox" class="w-12 h-12 stroke-1"}}}
      <span class="text-sm">未找到符合当前过滤条件的日志记录</span>
      <button x-show="searchKeyword || selectedLevels.length < 6" 
              @click="searchKeyword = ''; selectAllLevels()"
              class="text-xs text-sky-600 dark:text-[#58a6ff] hover:underline font-sans">
        重置搜索与级别过滤条件
      </button>
    </div>

    <!-- 日志表格 -->
    <table x-show="items.length > 0" class="w-full text-left text-sm border-collapse font-sans">
      <thead class="sticky top-0 bg-slate-50/95 dark:bg-[#161b22]/95 text-slate-600 dark:text-[#7d8590] text-[13px] font-semibold border-b border-slate-200 dark:border-[#30363d] z-10 backdrop-blur transition-colors select-none">
        <tr>
          <th class="py-2.5 px-4 w-32 font-semibold">Level</th>
          <th class="py-2.5 px-4 w-44 font-mono font-semibold">Time</th>
          <th class="py-2.5 px-4 w-40 font-semibold">Context / ReqId</th>
          <th class="py-2.5 px-4 font-semibold">Message / Summary</th>
          <th class="py-2.5 px-4 w-12 text-right"></th>
        </tr>
      </thead>
      <template x-for="(item, index) in items" :key="item.id">
        <tbody :id="'log-row-' + index"
               class="font-mono border-b border-slate-100 dark:border-[#21262d] transition-colors"
               :class="{
                 'bg-sky-50/70 dark:bg-[#1f6feb]/15 ring-2 ring-inset ring-sky-400 dark:ring-[#388bfd]': selectedIndex === index,
                 'animate-pulse-row': item.isNew
               }">
          <tr class="group hover:bg-slate-50/80 dark:hover:bg-[#161b22]/70 transition cursor-pointer"
              @click="selectedIndex = index; toggleRow(item.id)">
            <!-- 级别 Badge -->
            <td class="py-3 px-4 align-top">
              <div class="flex items-center space-x-2">
                <template x-if="item.level === 'fatal' || item.level === 'error'">
                  <span class="w-4 h-4 rounded-full bg-rose-500 dark:bg-[#f85149] text-white flex items-center justify-center text-[10px] font-bold shrink-0 shadow-sm">!</span>
                </template>
                <template x-if="item.level === 'info'">
                  <span class="w-4 h-4 rounded-full bg-sky-500 dark:bg-[#1f6feb] text-white flex items-center justify-center text-[10px] font-bold italic shrink-0 shadow-sm">i</span>
                </template>
                <template x-if="item.level === 'warn'">
                  <span class="w-4 h-4 rounded-full bg-amber-500 dark:bg-[#d29922] text-white flex items-center justify-center text-[10px] font-bold shrink-0 shadow-sm">!</span>
                </template>
                <template x-if="item.level === 'debug'">
                  <span class="w-4 h-4 rounded-full bg-purple-500 dark:bg-[#8957e5] text-white flex items-center justify-center text-[10px] font-bold shrink-0 shadow-sm">d</span>
                </template>
                <template x-if="item.level === 'trace'">
                  <span class="w-4 h-4 rounded-full bg-slate-400 dark:bg-[#6e7681] text-white flex items-center justify-center text-[10px] font-bold shrink-0 shadow-sm">t</span>
                </template>

                <span class="font-bold text-xs uppercase font-sans tracking-wide"
                      :class="{
                        'text-rose-600 dark:text-[#ff7b72]': item.level === 'fatal' || item.level === 'error',
                        'text-sky-600 dark:text-[#58a6ff]': item.level === 'info',
                        'text-amber-600 dark:text-[#d29922]': item.level === 'warn',
                        'text-purple-600 dark:text-[#d2a8ff]': item.level === 'debug',
                        'text-slate-600 dark:text-[#7d8590]': item.level === 'trace'
                      }"
                      x-text="item.level"></span>
              </div>
            </td>

            <!-- 时间戳 -->
            <td class="py-3 px-4 text-slate-800 dark:text-[#7d8590] text-xs font-mono align-top whitespace-nowrap" x-text="item.timestamp"></td>

            <!-- Context / ReqId 链路联动徽章 -->
            <td class="py-3 px-4 align-top whitespace-nowrap text-xs space-y-1">
              <div class="flex items-center space-x-1">
                <span @click.stop="filterBy(item.context, '已按 Context: ' + item.context + ' 过滤')"
                      class="px-2 py-0.5 rounded bg-slate-100 dark:bg-[#21262d] text-slate-700 dark:text-[#c9d1d9] hover:text-sky-600 dark:hover:text-[#58a6ff] hover:underline cursor-pointer font-medium font-sans truncate max-w-[140px]"
                      :title="'点击过滤 Context: ' + (item.context || 'App')">
                  <span x-text="item.context || 'App'"></span>
                </span>
              </div>

              <!-- ReqId (若存在支持一键链路过滤与复制) -->
              <template x-if="item.reqId">
                <div class="flex items-center space-x-1">
                  <span @click.stop="filterBy(item.reqId, '已按 ReqId: ' + item.reqId + ' 过滤链路')"
                        class="px-1.5 py-0.2 rounded bg-sky-500/10 dark:bg-[#388bfd]/15 text-sky-700 dark:text-[#58a6ff] hover:underline cursor-pointer text-[11px] font-mono truncate max-w-[140px]"
                        :title="'点击过滤链路追踪 ReqId: ' + item.reqId"
                        x-html="highlightText(item.reqId)"></span>
                  <button @click.stop="copyText(item.reqId, '已复制 ReqId')" title="复制 ReqId" class="text-slate-400 hover:text-slate-700 dark:hover:text-white">
                    {{{icon "copy" class="w-3 h-3"}}}
                  </button>
                </div>
              </template>
            </td>

            <!-- 消息主内容 (支持搜索荧光高亮、换行模式与 HTTP 请求快速标签) -->
            <td class="py-3 px-4 text-slate-900 dark:text-[#e6edf3] text-[13.5px] font-mono align-top"
                :class="wrapLines ? 'break-all leading-relaxed' : 'truncate max-w-[520px] whitespace-nowrap'">
              <div class="flex flex-wrap items-center gap-1.5 mb-1" x-show="item.req?.method || item.res?.statusCode">
                <!-- HTTP Method -->
                <template x-if="item.req?.method">
                  <span class="px-1.5 py-0.2 rounded text-[11px] font-bold font-sans uppercase"
                        :class="{
                          'bg-emerald-500/15 text-emerald-700 dark:text-[#3fb950]': item.req.method === 'GET',
                          'bg-sky-500/15 text-sky-700 dark:text-[#58a6ff]': item.req.method === 'POST',
                          'bg-amber-500/15 text-amber-700 dark:text-[#d29922]': item.req.method === 'PUT' || item.req.method === 'PATCH',
                          'bg-rose-500/15 text-rose-700 dark:text-[#f85149]': item.req.method === 'DELETE'
                        }"
                        x-text="item.req.method"></span>
                </template>

                <!-- HTTP Status Code -->
                <template x-if="item.res?.statusCode">
                  <span @click.stop="filterBy(item.res.statusCode, '已按 HTTP 状态码: ' + item.res.statusCode + ' 过滤')"
                        class="px-1.5 py-0.2 rounded text-[11px] font-bold font-mono cursor-pointer hover:underline"
                        :class="{
                          'bg-emerald-500/15 text-emerald-700 dark:text-[#3fb950]': item.res.statusCode < 300,
                          'bg-sky-500/15 text-sky-700 dark:text-[#58a6ff]': item.res.statusCode >= 300 && item.res.statusCode < 400,
                          'bg-amber-500/15 text-amber-700 dark:text-[#d29922]': item.res.statusCode >= 400 && item.res.statusCode < 500,
                          'bg-rose-500/15 text-rose-700 dark:text-[#f85149]': item.res.statusCode >= 500
                        }"
                        x-text="item.res.statusCode"></span>
                </template>

                <!-- 响应时间 (若有) -->
                <template x-if="item.responseTime">
                  <span class="px-1.5 py-0.2 rounded text-[11px] font-mono text-slate-500 dark:text-[#7d8590] bg-slate-100 dark:bg-[#21262d]"
                        x-text="item.responseTime + 'ms'"></span>
                </template>
              </div>

              <!-- Message 文本 (包含关键词荧光高亮) -->
              <span :class="{'text-rose-600 dark:text-[#ff7b72] font-semibold': item.level === 'error' || item.level === 'fatal'}"
                    x-html="highlightText(item.msg)"></span>
            </td>

            <!-- 展开箭头 -->
            <td class="py-3 px-4 text-right text-slate-400 dark:text-[#7d8590] align-top">
              {{{icon "chevron-right" class="w-4 h-4 transition transform" attrs=':class="{\"rotate-90 text-sky-600 dark:text-[#58a6ff]\": expandedRows[item.id]}"'}}}
            </td>
          </tr>

          <!-- 展开详情抽屉 (Formatted / Raw JSON) -->
          <tr x-show="expandedRows[item.id]" x-cloak class="bg-slate-50/95 dark:bg-[#0d1117] border-t border-slate-200 dark:border-[#30363d] transition-colors">
            <td colspan="5" class="p-5" @click.stop>
              <div class="space-y-4 font-mono text-sm">
                
                <!-- 详情头部标签切换 -->
                <div class="flex items-center justify-between border-b border-slate-200 dark:border-[#21262d] pb-2.5">
                  <div class="flex items-center space-x-5 text-sm">
                    <button @click="rowTabs[item.id] = 'formatted'"
                            :class="rowTabs[item.id] !== 'raw' ? 'text-sky-600 dark:text-[#58a6ff] border-b-2 border-sky-600 dark:border-[#1f6feb] pb-1 font-bold' : 'text-slate-500 hover:text-slate-900 dark:hover:text-[#e6edf3] pb-1'">
                      结构化详情 (Formatted)
                    </button>
                    <button @click="rowTabs[item.id] = 'raw'"
                            :class="rowTabs[item.id] === 'raw' ? 'text-sky-600 dark:text-[#58a6ff] border-b-2 border-sky-600 dark:border-[#1f6feb] pb-1 font-bold' : 'text-slate-500 hover:text-slate-900 dark:hover:text-[#e6edf3] pb-1'">
                      Raw JSON (语法高亮)
                    </button>
                  </div>
                  <div class="flex items-center space-x-2">
                    <template x-if="item.req?.url">
                      <button @click="copyAsCurl(item)" class="px-3 py-1.5 bg-white dark:bg-[#21262d] hover:bg-slate-100 dark:hover:bg-[#30363d] text-xs rounded-lg text-slate-700 dark:text-[#c9d1d9] border border-slate-200 dark:border-[#30363d] flex items-center space-x-1.5 transition shadow-sm font-sans font-medium" title="一键复制可复现该请求的 cURL 命令">
                        {{{icon "terminal" class="w-3.5 h-3.5 text-sky-500 dark:text-[#58a6ff]"}}}
                        <span>复制为 cURL</span>
                      </button>
                    </template>
                    <button @click="copyText(JSON.stringify(item.raw, null, 2), '已复制完整 Raw JSON')" class="px-3 py-1.5 bg-white dark:bg-[#21262d] hover:bg-slate-100 dark:hover:bg-[#30363d] text-xs rounded-lg text-slate-700 dark:text-[#c9d1d9] border border-slate-200 dark:border-[#30363d] flex items-center space-x-1.5 transition shadow-sm font-sans font-medium">
                      {{{icon "copy" class="w-3.5 h-3.5"}}}
                      <span>复制完整 JSON</span>
                    </button>
                  </div>
                </div>

                <!-- 选项卡 1：Formatted 视图 -->
                <div x-show="rowTabs[item.id] !== 'raw'" class="space-y-3">
                  <!-- 基础元数据网格 -->
                  <div class="grid grid-cols-2 md:grid-cols-4 gap-3 text-xs font-sans">
                    <div class="bg-white dark:bg-[#161b22] p-3 rounded-lg border border-slate-200 dark:border-[#30363d] shadow-sm space-y-1">
                      <span class="text-slate-400 dark:text-[#7d8590] block text-xs">进程 / 节点 (PID / HOST)</span>
                      <span class="text-slate-800 dark:text-[#e6edf3] font-semibold text-sm font-mono" x-text="(item.pid || '-') + ' @ ' + (item.hostname || '-')"></span>
                    </div>
                    <div class="bg-white dark:bg-[#161b22] p-3 rounded-lg border border-slate-200 dark:border-[#30363d] shadow-sm space-y-1">
                      <span class="text-slate-400 dark:text-[#7d8590] block text-xs">HTTP 请求与状态</span>
                      <div class="flex items-center space-x-1.5 font-mono">
                        <span class="font-bold text-sm" x-text="item.req?.method || '-'"></span>
                        <span class="font-bold text-sm" 
                              :class="{
                                'text-emerald-600 dark:text-[#3fb950]': item.res?.statusCode < 300,
                                'text-amber-600 dark:text-[#d29922]': item.res?.statusCode >= 400 && item.res?.statusCode < 500,
                                'text-rose-600 dark:text-[#f85149]': item.res?.statusCode >= 500
                              }"
                              x-text="item.res?.statusCode ? 'HTTP ' + item.res.statusCode : ''"></span>
                      </div>
                    </div>
                    <div class="bg-white dark:bg-[#161b22] p-3 rounded-lg border border-slate-200 dark:border-[#30363d] shadow-sm space-y-1">
                      <span class="text-slate-400 dark:text-[#7d8590] block text-xs">响应耗时 (Response Time)</span>
                      <span class="text-slate-800 dark:text-[#e6edf3] font-semibold text-sm font-mono" 
                            :class="{
                              'text-emerald-600 dark:text-[#3fb950]': item.responseTime && item.responseTime < 100,
                              'text-amber-600 dark:text-[#d29922]': item.responseTime && item.responseTime >= 100 && item.responseTime < 500,
                              'text-rose-600 dark:text-[#f85149]': item.responseTime && item.responseTime >= 500
                            }"
                            x-text="item.responseTime ? item.responseTime + ' ms' : '-'"></span>
                    </div>
                    <div class="bg-white dark:bg-[#161b22] p-3 rounded-lg border border-slate-200 dark:border-[#30363d] shadow-sm space-y-1">
                      <span class="text-slate-400 dark:text-[#7d8590] block text-xs">客户端 IP</span>
                      <span class="text-slate-800 dark:text-[#e6edf3] font-semibold text-sm font-mono" x-text="item.req?.remoteAddress || '-'"></span>
                    </div>
                  </div>

                  <!-- 错误堆栈高亮框 -->
                  <template x-if="item.stack || item.err?.stack">
                    <div class="mt-3">
                      <div class="flex items-center justify-between text-xs text-rose-600 dark:text-[#ff7b72] font-semibold mb-1.5 font-sans">
                        <span class="flex items-center space-x-1.5">
                          {{{icon "bug" class="w-4 h-4"}}}
                          <span>错误堆栈追踪 (Error Stack Trace)</span>
                        </span>
                        <button @click="copyText(item.stack || item.err?.stack, '已复制错误堆栈')" class="text-xs text-slate-500 dark:text-[#7d8590] hover:underline font-sans flex items-center space-x-1">
                          {{{icon "copy" class="w-3 h-3"}}}
                          <span>复制堆栈</span>
                        </button>
                      </div>
                      <pre class="p-4 bg-rose-50/80 dark:bg-[#f85149]/10 border border-rose-200 dark:border-[#f85149]/30 rounded-xl text-rose-900 dark:text-[#ff7b72] text-xs overflow-x-auto whitespace-pre-wrap leading-relaxed shadow-sm font-mono"
                           x-text="item.stack || item.err?.stack"></pre>
                    </div>
                  </template>
                </div>

                <!-- 选项卡 2：Raw JSON 语法高亮视图 -->
                <div x-show="rowTabs[item.id] === 'raw'">
                  <pre class="p-4 bg-slate-900 dark:bg-[#0d1117] rounded-xl text-slate-200 text-xs overflow-x-auto whitespace-pre-wrap leading-relaxed border border-slate-800 dark:border-[#30363d] font-mono shadow-inner"
                       x-html="syntaxHighlightJson(item.raw)"></pre>
                </div>
              </div>
            </td>
          </tr>
        </tbody>
      </template>
    </table>
  </div>

  <!-- 底部状态与分页栏 -->
  <footer class="h-14 border-t border-slate-200 dark:border-[#30363d] bg-white dark:bg-[#161b22] px-6 flex items-center justify-between shrink-0 text-sm text-slate-500 dark:text-[#7d8590] font-mono select-none transition-colors">
    <div class="flex items-center space-x-4">
      <div class="flex items-center space-x-1.5 text-xs">
        <span>显示</span>
        <span class="text-slate-800 dark:text-[#e6edf3] font-semibold" x-text="showingRange"></span>
        <span>/ 共</span>
        <span class="text-sky-600 dark:text-[#58a6ff] font-semibold" x-text="meta.total"></span>
        <span>条记录</span>
      </div>

      <!-- 实时日志自动滚底开关 -->
      <label x-show="liveStreamActive" class="hidden md:flex items-center space-x-1.5 text-xs cursor-pointer text-slate-600 dark:text-[#7d8590] font-sans">
        <input type="checkbox" x-model="autoScrollLive" class="rounded border-slate-300 dark:border-[#30363d] text-sky-500 focus:ring-0">
        <span>新日志自动置顶</span>
      </label>
    </div>

    <!-- 分页控制器 -->
    <div class="flex items-center space-x-2 text-sm font-sans">
      <button @click="goToPage(meta.page - 1)" :disabled="meta.page <= 1"
              :class="meta.page <= 1 ? 'opacity-40 cursor-not-allowed' : 'hover:bg-slate-100 dark:hover:bg-[#30363d] text-slate-700 dark:text-[#c9d1d9]'"
              class="px-3 py-1.5 rounded-lg bg-white dark:bg-[#21262d] border border-slate-300 dark:border-[#30363d] transition shadow-sm font-medium text-xs">
        上一页
      </button>

      <div class="px-2 text-slate-700 dark:text-[#c9d1d9] font-mono font-semibold text-xs">
        <span x-text="meta.page"></span> / <span x-text="meta.totalPages || 1"></span>
      </div>

      <button @click="goToPage(meta.page + 1)" :disabled="meta.page >= meta.totalPages"
              :class="meta.page >= meta.totalPages ? 'opacity-40 cursor-not-allowed' : 'hover:bg-slate-100 dark:hover:bg-[#30363d] text-slate-700 dark:text-[#c9d1d9]'"
              class="px-3 py-1.5 rounded-lg bg-white dark:bg-[#21262d] border border-slate-300 dark:border-[#30363d] transition shadow-sm font-medium text-xs">
        下一页
      </button>
    </div>
  </footer>

  <!-- 浮动层：Toast 通知队列与确认 Modal -->
  <div class="fixed bottom-6 right-6 z-50 flex flex-col space-y-2.5 max-w-sm pointer-events-none">
    <template x-for="t in toasts" :key="t.id">
      <div class="pointer-events-auto flex items-center space-x-3 px-4 py-3 rounded-xl shadow-2xl border backdrop-blur transition transform translate-y-0 animate-in fade-in slide-in-from-right-4 duration-200"
           :class="{
             'bg-emerald-950/90 text-emerald-200 border-emerald-500/40': t.type === 'success',
             'bg-rose-950/90 text-rose-200 border-rose-500/40': t.type === 'error',
             'bg-amber-950/90 text-amber-200 border-amber-500/40': t.type === 'warning',
             'bg-slate-900/95 text-slate-100 border-slate-700': t.type === 'info'
           }">
        <template x-if="t.type === 'success'">
          {{{icon "check-circle" class="w-4 h-4 text-emerald-400 shrink-0"}}}
        </template>
        <template x-if="t.type === 'error'">
          {{{icon "alert-circle" class="w-4 h-4 text-rose-400 shrink-0"}}}
        </template>
        <template x-if="t.type === 'warning'">
          {{{icon "alert-triangle" class="w-4 h-4 text-amber-400 shrink-0"}}}
        </template>
        <template x-if="t.type === 'info'">
          {{{icon "info" class="w-4 h-4 text-sky-400 shrink-0"}}}
        </template>
        
        <span class="text-xs font-medium font-sans flex-1" x-text="t.message"></span>
        <button @click="removeToast(t.id)" class="text-slate-400 hover:text-white p-0.5">
          {{{icon "x" class="w-3 h-3"}}}
        </button>
      </div>
    </template>
  </div>

  <!-- 毛玻璃确认对话框 (Confirm Modal) -->
  <div x-show="confirmModal.show" x-cloak
       class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/60 backdrop-blur-sm transition-opacity">
    <div @click.outside="closeConfirm()"
         class="bg-white dark:bg-[#161b22] border border-slate-200 dark:border-[#30363d] rounded-2xl shadow-2xl max-w-md w-full p-6 space-y-4 font-sans text-slate-900 dark:text-[#e6edf3] animate-in fade-in zoom-in-95 duration-150">
      <div class="flex items-center space-x-3">
        <div class="w-10 h-10 rounded-full flex items-center justify-center shrink-0"
             :class="confirmModal.isDestructive ? 'bg-rose-500/10 text-rose-500' : 'bg-sky-500/10 text-sky-500'">
          {{{icon "alert-circle" class="w-5 h-5"}}}
        </div>
        <div>
          <h3 class="text-base font-bold" x-text="confirmModal.title"></h3>
          <p class="text-xs text-slate-500 dark:text-[#7d8590] mt-0.5" x-text="confirmModal.message"></p>
        </div>
      </div>

      <div class="flex items-center justify-end space-x-2.5 pt-2">
        <button @click="closeConfirm()" 
                class="px-4 py-2 rounded-lg border border-slate-300 dark:border-[#30363d] bg-white dark:bg-[#21262d] hover:bg-slate-50 dark:hover:bg-[#30363d] text-xs font-semibold transition">
          <span x-text="confirmModal.cancelText"></span>
        </button>
        <button @click="executeConfirm()" 
                class="px-4 py-2 rounded-lg text-xs font-semibold text-white shadow-sm transition"
                :class="confirmModal.isDestructive ? 'bg-rose-600 hover:bg-rose-500' : 'bg-sky-600 hover:bg-sky-500'">
          <span x-text="confirmModal.confirmText"></span>
        </button>
      </div>
    </div>
  </div>

  <!-- 键盘快捷键指南模态框 (Shortcuts Modal) -->
  <div x-show="showShortcutsModal" x-cloak
       class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/60 backdrop-blur-sm transition-opacity">
    <div @click.outside="showShortcutsModal = false"
         class="bg-white dark:bg-[#161b22] border border-slate-200 dark:border-[#30363d] rounded-2xl shadow-2xl max-w-lg w-full p-6 space-y-5 font-sans text-slate-900 dark:text-[#e6edf3] animate-in fade-in zoom-in-95 duration-150">
      <div class="flex items-center justify-between border-b border-slate-200 dark:border-[#30363d] pb-3">
        <div class="flex items-center space-x-2.5">
          <div class="w-8 h-8 rounded-lg bg-sky-500/10 dark:bg-[#388bfd]/15 text-sky-600 dark:text-[#58a6ff] flex items-center justify-center">
            {{{icon "keyboard" class="w-4 h-4"}}}
          </div>
          <div>
            <h3 class="text-sm font-bold">全键盘快捷键指南</h3>
            <p class="text-xs text-slate-500 dark:text-[#7d8590]">Vim / Sentry 标杆生产力键盘映射</p>
          </div>
        </div>
        <button @click="showShortcutsModal = false" class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 p-1">
          {{{icon "x" class="w-4 h-4"}}}
        </button>
      </div>

      <div class="space-y-4 text-xs">
        <div>
          <div class="text-[11px] font-semibold text-slate-400 dark:text-[#7d8590] uppercase tracking-wider mb-2">列表导航 & 查看</div>
          <div class="grid grid-cols-2 gap-2">
            <div class="flex items-center justify-between p-2 rounded-lg bg-slate-50 dark:bg-[#0d1117] border border-slate-100 dark:border-[#21262d]">
              <span class="text-slate-600 dark:text-[#8b949e]">移动高亮行</span>
              <div class="flex items-center space-x-1 font-mono">
                <kbd class="px-1.5 py-0.5 rounded bg-white dark:bg-[#21262d] border border-slate-200 dark:border-[#30363d] shadow-sm text-[11px]">j</kbd>
                <kbd class="px-1.5 py-0.5 rounded bg-white dark:bg-[#21262d] border border-slate-200 dark:border-[#30363d] shadow-sm text-[11px]">k</kbd>
              </div>
            </div>
            <div class="flex items-center justify-between p-2 rounded-lg bg-slate-50 dark:bg-[#0d1117] border border-slate-100 dark:border-[#21262d]">
              <span class="text-slate-600 dark:text-[#8b949e]">展开/折叠行详情</span>
              <div class="flex items-center space-x-1 font-mono">
                <kbd class="px-1.5 py-0.5 rounded bg-white dark:bg-[#21262d] border border-slate-200 dark:border-[#30363d] shadow-sm text-[11px]">Enter</kbd>
                <kbd class="px-1.5 py-0.5 rounded bg-white dark:bg-[#21262d] border border-slate-200 dark:border-[#30363d] shadow-sm text-[11px]">Space</kbd>
              </div>
            </div>
            <div class="flex items-center justify-between p-2 rounded-lg bg-slate-50 dark:bg-[#0d1117] border border-slate-100 dark:border-[#21262d]">
              <span class="text-slate-600 dark:text-[#8b949e]">切换自动换行</span>
              <kbd class="px-1.5 py-0.5 rounded bg-white dark:bg-[#21262d] border border-slate-200 dark:border-[#30363d] shadow-sm font-mono text-[11px]">w</kbd>
            </div>
            <div class="flex items-center justify-between p-2 rounded-lg bg-slate-50 dark:bg-[#0d1117] border border-slate-100 dark:border-[#21262d]">
              <span class="text-slate-600 dark:text-[#8b949e]">复制选中 JSON</span>
              <kbd class="px-1.5 py-0.5 rounded bg-white dark:bg-[#21262d] border border-slate-200 dark:border-[#30363d] shadow-sm font-mono text-[11px]">c</kbd>
            </div>
          </div>
        </div>

        <div>
          <div class="text-[11px] font-semibold text-slate-400 dark:text-[#7d8590] uppercase tracking-wider mb-2">操作 & 检索</div>
          <div class="grid grid-cols-2 gap-2">
            <div class="flex items-center justify-between p-2 rounded-lg bg-slate-50 dark:bg-[#0d1117] border border-slate-100 dark:border-[#21262d]">
              <span class="text-slate-600 dark:text-[#8b949e]">聚焦搜索栏</span>
              <kbd class="px-1.5 py-0.5 rounded bg-white dark:bg-[#21262d] border border-slate-200 dark:border-[#30363d] shadow-sm font-mono text-[11px]">/</kbd>
            </div>
            <div class="flex items-center justify-between p-2 rounded-lg bg-slate-50 dark:bg-[#0d1117] border border-slate-100 dark:border-[#21262d]">
              <span class="text-slate-600 dark:text-[#8b949e]">立即刷新日志</span>
              <kbd class="px-1.5 py-0.5 rounded bg-white dark:bg-[#21262d] border border-slate-200 dark:border-[#30363d] shadow-sm font-mono text-[11px]">r</kbd>
            </div>
            <div class="flex items-center justify-between p-2 rounded-lg bg-slate-50 dark:bg-[#0d1117] border border-slate-100 dark:border-[#21262d]">
              <span class="text-slate-600 dark:text-[#8b949e]">切换实时日志流</span>
              <kbd class="px-1.5 py-0.5 rounded bg-white dark:bg-[#21262d] border border-slate-200 dark:border-[#30363d] shadow-sm font-mono text-[11px]">l</kbd>
            </div>
            <div class="flex items-center justify-between p-2 rounded-lg bg-slate-50 dark:bg-[#0d1117] border border-slate-100 dark:border-[#21262d]">
              <span class="text-slate-600 dark:text-[#8b949e]">打开/关闭帮助</span>
              <kbd class="px-1.5 py-0.5 rounded bg-white dark:bg-[#21262d] border border-slate-200 dark:border-[#30363d] shadow-sm font-mono text-[11px]">?</kbd>
            </div>
          </div>
        </div>
      </div>

      <div class="flex items-center justify-between pt-2 border-t border-slate-200 dark:border-[#30363d] text-[11px] text-slate-400 dark:text-[#7d8590]">
        <span>提示：输入框聚焦时快捷键自动静音</span>
        <button @click="showShortcutsModal = false" class="px-3 py-1.5 rounded-lg bg-slate-100 dark:bg-[#21262d] hover:bg-slate-200 dark:hover:bg-[#30363d] text-slate-700 dark:text-[#c9d1d9] font-medium transition">
          我知道了
        </button>
      </div>
    </div>
  </div>
</main>

