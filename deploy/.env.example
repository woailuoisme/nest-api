# ==============================================================================
# Docker Compose 生产与部署统一环境变量配置模板 (deploy/.env.example)
# 使用方式: cp deploy/.env.example deploy/.env 并根据实际部署环境修改凭据
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Centrifugo 实时推送与协同网关服务 (Realtime)
# ------------------------------------------------------------------------------
CENTRIFUGO_PORT=8000

# 客户端长连接建立与私有频道订阅鉴权密钥 (HMAC-SHA256，与后端 REALTIME_URL 保持一致)
CENTRIFUGO_TOKEN_HMAC_SECRET_KEY=your-centrifugo-token-hmac-secret-key

# 后端服务调用 HTTP API (广播、私信、批量推送、在场检索) 鉴权密钥 (与后端 REALTIME_URL 保持一致)
CENTRIFUGO_API_KEY=your-centrifugo-api-key

# Centrifugo Web 管理控制台鉴权凭据 (强随机密码与 Cookie/JWT 签名密钥)
CENTRIFUGO_ADMIN_PASSWORD=your-secure-admin-password
CENTRIFUGO_ADMIN_SECRET=your-secure-admin-secret-key-hex

# Proxy 回调共享密钥 (≥16 字符)。两端必须成对配置才生效：
#   1) 后端：CENTRIFUGO_PROXY_SECRET
#   2) 网关静态头（Centrifugo ≥5.0.2，JSON 字符串，无需改 config.yaml）：
#      CENTRIFUGO_PROXY_STATIC_HTTP_HEADERS={"X-Centrifugo-Proxy-Secret":"<同一个值>"}
# 仅一端配置的后果：只配网关 → 后端放行（无用）；只配后端 → 所有订阅回调 401（实时不可用）。
# 生成: openssl rand -hex 32
CENTRIFUGO_PROXY_SECRET=
# CENTRIFUGO_PROXY_STATIC_HTTP_HEADERS={"X-Centrifugo-Proxy-Secret":"replace-with-the-same-secret"}

# ------------------------------------------------------------------------------
# 2. 业务服务集群 (API)
# ------------------------------------------------------------------------------
APP_NAME=nest-api
APP_ENV=production
APP_DEBUG=false
PORT=4300
APP_URL=http://localhost:4300
# 反向代理信任策略：仅填网关所在的 CIDR / 地址（逗号分隔），不得用 true。
# true 等于信任全部跳数——Fastify 取 X-Forwarded-For 最左值，客户端可伪造 →
# 按 IP 限流与幂等作用域失效（生产环境启动即报错）。
# 例：TRUST_PROXY=172.16.0.0/12（Docker 默认桥接网段）
TRUST_PROXY=

# 数据库连接 (PostgreSQL 容器)
DB_URL="postgresql://postgres:postgres_password@postgres:5432/nestforge?schema=public"

# Redis 缓存与分布式锁 (Valkey / Redis 容器)
REDIS_URL=redis://:redis_secret@valkey:6379/0

# Better Auth 鉴权密钥 (至少 16 字符；建议直接使用 just cmd jwt:secret 生成 32+ 字符随机串)
BETTER_AUTH_SECRET=your-better-auth-secret-key-minimum-16-chars

# 邮件队列服务 (Mailpit / SMTP 容器)
MAIL_URL=smtp://mailpit:1025

# 对象存储 (Garage / MinIO S3 兼容容器)
STORAGE_S3_URL="s3://access_key:secret_key@garage:3900/default?region=garage&publicUrl=http://garage:3900/default"

# 实时服务 DSN (连接同网络下的 realtime:8000)
REALTIME_URL="centrifugo://your-centrifugo-api-key:your-centrifugo-token-hmac-secret-key@realtime:8000/api?tls=false"

# ------------------------------------------------------------------------------
# 3. Meilisearch 全文搜索引擎服务 (Search)
# ------------------------------------------------------------------------------
MEILISEARCH_PORT=7700
MEILISEARCH_MASTER_KEY=your-meilisearch-master-key-min-16-bytes
SEARCH_URL="meilisearch://your-meilisearch-master-key-min-16-bytes@meilisearch:7700"

# ------------------------------------------------------------------------------
# 4. imgproxy 动态图像处理服务 (Media)
# ------------------------------------------------------------------------------
IMGPROXY_PORT=8080
IMGPROXY_KEY=9348e3a2b1c4d5e6f7a8b9c0d1e2f3a4
IMGPROXY_SALT=5678f1a2b3c4d5e6f7a8b9c0d1e2f3a4
IMGPROXY_URL="imgproxy://9348e3a2b1c4d5e6f7a8b9c0d1e2f3a4:5678f1a2b3c4d5e6f7a8b9c0d1e2f3a4@imgproxy:8080?publicUrl=http://localhost:8080"

# S3 对象存储凭据与端点 (供 imgproxy 容器拉取 S3 图像，如对接 Garage / MinIO / AWS S3)
AWS_ACCESS_KEY_ID=your-s3-access-key-id
AWS_SECRET_ACCESS_KEY=your-s3-secret-access-key
AWS_REGION=garage
AWS_ENDPOINT=http://garage:3900

# ------------------------------------------------------------------------------
# 5. Mosquitto 工业物联网 MQTT 5.0 Broker (IoT)
# ------------------------------------------------------------------------------
# Broker 强制账号密码 + 主题级 ACL，匿名连接一律拒绝（无匿名档位）。
# 首次启动前必须先准备凭据（文件不入库，位于 deploy/mosquitto/config/credentials/）:
#   just mqtt-passwd -c -b /creds/password.txt nestforge-api '<强密码>'
#   just mqtt-passwd -b /creds/password.txt device-01 '<设备密钥>'
#   just mqtt-acl
MOSQUITTO_PORT=1883
MOSQUITTO_WS_PORT=9001

# NestJS API 自身的 Broker 连接串：用户名/密码必须与 password.txt 逐字一致
MQTT_URL="mqtt://nestforge-api:CHANGE_ME@mosquitto:1883?clientId=nestforge-api"

# 设备接入凭证表 (一机一密，格式: deviceId:secret，多个以英文逗号分隔；留空表示禁止设备换票)
# 生产环境应逐个设备登记，示例如下（设备密钥同样需写入 password.txt 才能接入 Broker）
# IOT_DEVICE_CREDENTIALS=device-01:s3cr3t-abc123,device-02:s3cr3t-def456
IOT_DEVICE_CREDENTIALS=
# 设备接入 JWT 独立签名密钥 (≥32 字符，必须与 BETTER_AUTH_SECRET 域分离；生成: openssl rand -base64 48)
IOT_JWT_SECRET=
# 设备密钥校验用 HMAC 加固盐值 (Pepper，≥16 字符，生产环境必填且禁止使用公开默认值；生成: openssl rand -hex 32)
IOT_DEVICE_PEPPER=
# 设备租户归属表 (格式: deviceId:tenantId，逗号分隔)：设备 token 的租户声明只来自本表，不来自请求体
# IOT_DEVICE_TENANTS=device-01:factory-a,device-02:factory-b
IOT_DEVICE_TENANTS=

# ------------------------------------------------------------------------------
# 6. 微信支付 v3（直连商户，按需启用）
# ------------------------------------------------------------------------------
# 留空时驱动按凭证齐全度推导；生产环境若推导为 mock 会拒绝启动。
# 未接入真实支付时显式声明退让（真实回调将全部验签失败，仅适合尚未开通支付的部署）：
WEPAY_ALLOW_MOCK=true
# WEPAY_APPID=wx1234567890abcdef
# WEPAY_MCHID=1900000001
# WEPAY_SERIAL_NO=4A3B2C1D9E8F7A6B5C4D3E2F1A0B9C8D7E6F5A4B
# WEPAY_APIV3_KEY=your-32-byte-apiv3-key-here
# WEPAY_PRIVATE_KEY_PATH=/run/secrets/wepay_private_key.pem

# ------------------------------------------------------------------------------
# 7. OpenTelemetry Collector → OpenObserve 可观测性 (三信号统一出口)
# ------------------------------------------------------------------------------
# 应用容器 OTLP 导出端点（经 backend 网络指向 collector；未配置时应用侧 SDK 不初始化）
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# OpenObserve 摄取端点（以组织段结尾、不带尾斜杠，collector 自动追加 /v1/traces|metrics|logs）
OO_ENDPOINT=https://your-openobserve-instance.example.com/api/default

# OpenObserve Basic 认证头（base64(email:ingest-token)，生成: echo -n 'you@example.com:token' | base64）
OO_AUTH=
