{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": false,
    "builder": "swc",
    "typeCheck": true,
    "tsConfigPath": "tsconfig.build.json",
    "assets": [
      { "include": "i18n/translations/**/*" },
      { "include": "common/mail/templates/*.hbs" },
      { "include": "commands/generator/templates/*.hbs" },
      { "include": "common/auth/casbin/*.csv" }
    ]
  }
}
