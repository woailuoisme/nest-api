{
  "$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
  // ── 扫描范围 ────────────────────────────────────────────
  "files": {
    "includes": ["src/**", "tests/**", "*.ts", "*.mts", "*.json", "*.jsonc", "!src/setup/log-viewer/ui/assets"]
  },
  // ── IDE 辅助（保存时自动整理 imports） ──────────────────
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      // ── 代码风格 ──────────────────────────────────────────
      "style": {
        "useImportType": "off", // NestJS 需要值类型同时导入，不用 type-only import
        "noParameterAssign": "error", // 禁止对参数重新赋值（避免意外修改外部引用）
        "useAsConstAssertion": "error", // 强制字面量使用 as const（避免类型拓宽）
        "useDefaultParameterLast": "error", // 有默认值的参数必须放在最后
        "useEnumInitializers": "error", // 枚举成员必须显式赋值（防止顺序依赖）
        "useConsistentArrayType": "error", // 统一 T[] 或 Array<T>（默认 T[]）
        "useShorthandAssign": "error", // a = a + 1 → a += 1
        "useNumberNamespace": "error", // 用 Number.isNaN 而非 isNaN
        "noUselessElse": "error", // if 里 return 了就不需要 else
        "useSingleVarDeclarator": "error" // 禁止逗号连写多个变量声明
      },
      // ── 可疑代码 ──────────────────────────────────────────
      "suspicious": {
        "noExplicitAny": "warn", // 显式 any 只警告（NestJS 装饰器/框架回调不可避免）
        "noConsole": "error", // 生产代码禁止 console.log（CLI/seeds 已豁免）
        "noArrayIndexKey": "warn" // 用 index 做 key 警告（无 React 所以仅 warn）
      },
      // ── 正确性 ────────────────────────────────────────────
      "correctness": {
        "noUnusedVariables": "error", // 未使用变量（测试文件已豁免）
        "noUnusedImports": "error", // 未使用导入 → organizeImports 已自动清理
        "noUnreachable": "error" // 死代码检测（return/throw 之后的代码）
      },
      // ── 复杂度 ────────────────────────────────────────────
      "complexity": {
        "noBannedTypes": "error", // 禁止 String/Number/Boolean 包装类、{} 空对象类型
        "noStaticOnlyClass": "error", // 只有静态成员的类 → 改用模块函数
        "noUselessConstructor": "error", // 无用 constructor（如空的 super() 调用）
        "noUselessLoneBlockStatements": "error" // 消除只含单个语句的无意义独立块 { ... }
      }
    }
  },
  "overrides": [
    // ── 测试文件：放宽限制 ────────────────────────────────
    {
      "includes": [
        "**/*.spec.ts",
        "**/*.test.ts",
        "**/*.e2e-test.ts",
        "**/tests/**/*.ts",
        "**/tests/**/*.js",
        "**/factories/**/*.ts",
        "**/mocks/**/*.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off", // mock 对象、动态断言不可避免
            "noConsole": "off" // 调试日志允写
          },
          "style": {
            "noNonNullAssertion": "off", // 测试中断言 null 检查前常需 ! 标记
            "noParameterAssign": "off" // mock 回调中修改参数常见
          },
          "correctness": {
            "noUnusedVariables": "off", // 部分变量仅用于断言链
            "noUnusedImports": "off" // 测试 setup 可能批量导入
          }
        }
      }
    },
    // ── Handlebars 模板与静态资产：完全跳过 ──────────────────────────
    {
      "includes": ["**/*.hbs", "src/setup/log-viewer/ui/assets/**/*"],
      "formatter": { "enabled": false },
      "linter": { "enabled": false }
    },
    // ── CLI / Seeds：允许 console ───────────────────────────
    {
      "includes": ["src/commands/**/*.ts", "src/database/seeds/**/*.ts", "src/cli.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off" // CLI 输出、种子脚本日志是合理需求
          }
        }
      }
    }
  ],
  // ── 格式化规则 ──────────────────────────────────────────
  "formatter": {
    "enabled": true,
    "indentStyle": "space", // 2 空格缩进
    "indentWidth": 2,
    "lineEnding": "lf", // Unix 换行（与 .gitattributes 对齐）
    "lineWidth": 120 // 120 列（与 AGENTS.md 对齐）
  },
  // ── TypeScript 特定 ─────────────────────────────────────
  "javascript": {
    "parser": {
      "unsafeParameterDecoratorsEnabled": true // NestJS @装饰器 参数支持
    },
    "formatter": {
      "quoteStyle": "single", // 单引号
      "semicolons": "always", // 强制分号
      "trailingCommas": "all" // 尾逗号（减少 git diff 噪音）
    }
  }
}
