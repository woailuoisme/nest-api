{
  "name": "nest-forge",
  "version": "0.1.0",
  "description": "Production-ready NestJS starter with Drizzle ORM",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "start": "WORKER_EMBEDDED=true node dist/main.js",
    "dev": "WORKER_EMBEDDED=true nest start --watch",
    "dev:all": "concurrently -k -n app,worker -c bgBlue.bold,bgMagenta.bold -p \"[{name}]\" \"nest start --watch\" \"tsx watch src/workers/worker.main.ts\"",
    "cli": "node dist/cli.js",
    "test": "vitest run --config vitest.config.mts",
    "test:watch": "vitest --config vitest.config.mts",
    "test:cov": "vitest run --coverage --config vitest.config.mts",
    "test:debug": "vitest --inspect-brk --no-file-parallelism --config vitest.config.mts",
    "test:e2e": "vitest run --config vitest.e2e.config.mts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1130.0",
    "@aws-sdk/s3-request-presigner": "^3.1130.0",
    "@better-auth/api-key": "^1.7.4",
    "@better-auth/drizzle-adapter": "^1.7.4",
    "@better-auth/i18n": "^1.7.4",
    "@better-auth/passkey": "^1.7.4",
    "@better-auth/sso": "^1.7.4",
    "@bull-board/api": "^9.10.0",
    "@bull-board/fastify": "^9.10.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^10.1.1",
    "@fastify/static": "^10.1.3",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/event-emitter": "^12.0.0",
    "@nestjs/platform-fastify": "^12.0.1",
    "@nestjs/swagger": "^12.0.1",
    "@nestjs/terminus": "^12.0.0",
    "@nestjs/throttler": "^6.5.0",
    "@scalar/client-side-rendering": "^0.4.0",
    "better-auth": "^1.7.4",
    "bullmq": "^6.3.4",
    "cockatiel": "^4.0.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "es-toolkit": "^1.52.0",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.4",
    "handlebars": "^4.7.9",
    "image-size": "^2.0.2",
    "ioredis": "^6.0.0",
    "meilisearch": "^0.62.0",
    "mqtt": "^5.15.2",
    "nest-commander": "^3.21.0",
    "nestjs-i18n": "^10.8.5",
    "nestjs-zod": "^5.5.0",
    "nodemailer": "^10.0.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "pino-roll": "^4.0.0",
    "pluralize": "^8.0.0",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "qs": "^6.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^14",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.2",
    "@types/node": "^26",
    "@types/nodemailer": "^8.0.1",
    "@types/pluralize": "^0.0.33",
    "@types/qrcode": "^1.5.6",
    "@types/qs": "^6.15.1",
    "@vitest/coverage-v8": "^5.0.0",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.10",
    "mjml": "^5.4.1",
    "tsx": "^4.23.13",
    "unplugin-swc": "^1.6.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=24"
  }
}
