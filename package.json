{
  "name": "nest-forge",
  "version": "0.1.0",
  "description": "Production-ready NestJS starter with Drizzle ORM",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "build": "nest build",
    "start": "WORKER_EMBEDDED=true node dist/main.js",
    "dev": "WORKER_EMBEDDED=true nest start --watch",
    "dev:all": "concurrently -k -n app,worker -c bgBlue.bold,bgMagenta.bold -p \"[{name}]\" \"nest start --watch\" \"nest start --entryFile workers/worker.main --watch\"",
    "cli": "node dist/cli.js",
    "test": "vitest run --config vitest.config.mts",
    "test:watch": "vitest --config vitest.config.mts",
    "test:cov": "vitest run --coverage --config vitest.config.mts",
    "test:debug": "vitest --inspect-brk --no-file-parallelism --config vitest.config.mts",
    "test:e2e": "vitest run --config vitest.e2e.config.mts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1144.0",
    "@aws-sdk/s3-request-presigner": "^3.1144.0",
    "@better-auth/api-key": "^1.7.7",
    "@better-auth/drizzle-adapter": "^1.7.7",
    "@better-auth/i18n": "^1.7.7",
    "@better-auth/passkey": "^1.7.7",
    "@better-auth/sso": "^1.7.7",
    "@bull-board/api": "^9.10.2",
    "@bull-board/fastify": "^9.10.2",
    "@fastify/compress": "^9.2.0",
    "@fastify/multipart": "^10.1.2",
    "@fastify/static": "^10.1.5",
    "@keyv/redis": "^5.1.6",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/cache-manager": "^12.0.0",
    "@nestjs/common": "^12.1.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.2",
    "@nestjs/event-emitter": "^12.0.1",
    "@nestjs/platform-fastify": "^12.1.2",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/terminus": "^12.1.0",
    "@nestjs/throttler": "^6.7.1",
    "@scalar/client-side-rendering": "^0.4.7",
    "@sentry/node": "^11.2.0",
    "better-auth": "^1.7.7",
    "bullmq": "^6.3.11",
    "cache-manager": "^7.2.9",
    "dotenv": "^18.0.5",
    "drizzle-orm": "^0.45.3",
    "es-toolkit": "^1.52.0",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.5",
    "handlebars": "^4.7.9",
    "image-size": "^2.0.4",
    "ioredis": "^6.0.0",
    "keyv": "^5.6.0",
    "meilisearch": "^0.62.0",
    "mqtt": "^5.16.0",
    "nest-commander": "^3.21.0",
    "nestjs-i18n": "^10.8.5",
    "nodemailer": "^10.0.13",
    "pino": "^10.3.1",
    "pluralize": "^8.0.0",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "qs": "^6.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^14",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.6",
    "@nestjs/testing": "^12.1.2",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.13",
    "@types/node": "^24",
    "@types/pluralize": "^0.0.33",
    "@types/qrcode": "^1.5.6",
    "@types/qs": "^6.15.1",
    "@vitest/coverage-v8": "^5.0.3",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.11",
    "mjml": "^5.4.1",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.15",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24"
  }
}
