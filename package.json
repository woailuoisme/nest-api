{
  "name": "nest-api",
  "version": "0.1.0",
  "description": "Production-ready NestJS starter with Drizzle ORM",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:worker": "node dist/workers/worker.main.js",
    "cli": "node dist/cli.js",
    "test": "vitest run --config vitest.config.mts",
    "test:watch": "vitest --config vitest.config.mts",
    "test:cov": "vitest run --coverage --config vitest.config.mts",
    "test:debug": "vitest --inspect-brk --no-file-parallelism --config vitest.config.mts",
    "test:e2e": "vitest run --config vitest.e2e.config.mts"
  },
