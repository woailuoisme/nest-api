# ==============================================================================
# Docker Compose 生产与部署统一环境变量配置模板 (docker/.env.example)
# 使用方式: cp docker/.env.example docker/.env 并根据实际部署环境修改凭据
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Centrifugo 实时推送与协同网关服务 (Realtime)
# ------------------------------------------------------------------------------
CENTRIFUGO_PORT=8000

# 客户端长连接建立与私有频道订阅鉴权密钥 (HMAC-SHA256，与后端 REALTIME_URL 保持一致)
CENTRIFUGO_TOKEN_HMAC_SECRET_KEY=your-centrifugo-token-hmac-secret-key

# 后端服务调用 HTTP API (广播、私信、批量推送、在场检索) 鉴权密钥 (与后端 REALTIME_URL 保持一致)
CENTRIFUGO_API_KEY=your-centrifugo-api-key

# Centrifugo Web 管理控制台鉴权凭据 (强随机密码与 Cookie/JWT 签名密钥)
CENTRIFUGO_ADMIN_PASSWORD=your-secure-admin-password
CENTRIFUGO_ADMIN_SECRET=your-secure-admin-secret-key-hex

# ------------------------------------------------------------------------------
# 2. NestForge 业务服务集群 (API)
# ------------------------------------------------------------------------------
APP_ENV=production
APP_DEBUG=false
PORT=4300
APP_URL=http://localhost:4300

# 数据库连接 (PostgreSQL 容器)
DB_URL="postgresql://postgres:postgres_password@postgres:5432/nestforge?schema=public"

# Redis 缓存与分布式锁 (Valkey / Redis 容器)
REDIS_URL=redis://:redis_secret@valkey:6379/0

# Better Auth 鉴权密钥 (至少 32 字符安全随机串)
BETTER_AUTH_SECRET=your-better-auth-secret-key-minimum-32-chars

# 邮件队列服务 (Mailpit / SMTP 容器)
MAIL_URL=smtp://mailpit:1025

# 对象存储 (Garage / MinIO S3 兼容容器)
STORAGE_S3_URL="s3://access_key:secret_key@garage:3900/default?region=garage&publicUrl=http://garage:3900/default"

# 实时服务 DSN (连接同网络下的 realtime:8000)
REALTIME_URL="centrifugo://your-centrifugo-api-key:your-centrifugo-token-hmac-secret-key@realtime:8000/api?tls=false"

# ------------------------------------------------------------------------------
# 3. Meilisearch 全文搜索引擎服务 (Search)
# ------------------------------------------------------------------------------
MEILISEARCH_PORT=7700
MEILISEARCH_MASTER_KEY=your-meilisearch-master-key-min-16-bytes
SEARCH_URL="meilisearch://your-meilisearch-master-key-min-16-bytes@meilisearch:7700"

# ------------------------------------------------------------------------------
# 4. imgproxy 动态图像处理服务 (Media)
# ------------------------------------------------------------------------------
IMGPROXY_PORT=8080
IMGPROXY_KEY=9348e3a2b1c4d5e6f7a8b9c0d1e2f3a4
IMGPROXY_SALT=5678f1a2b3c4d5e6f7a8b9c0d1e2f3a4
IMGPROXY_URL="imgproxy://9348e3a2b1c4d5e6f7a8b9c0d1e2f3a4:5678f1a2b3c4d5e6f7a8b9c0d1e2f3a4@imgproxy:8080?publicUrl=http://localhost:8080"

# S3 对象存储凭据与端点 (供 imgproxy 容器拉取 S3 图像，如对接 Garage / MinIO / AWS S3)
AWS_ACCESS_KEY_ID=your-s3-access-key-id
AWS_SECRET_ACCESS_KEY=your-s3-secret-access-key
AWS_REGION=garage
AWS_ENDPOINT=http://garage:3900

# ------------------------------------------------------------------------------
# 5. Mosquitto 工业物联网 MQTT 5.0 Broker (IoT)
# ------------------------------------------------------------------------------
MOSQUITTO_PORT=1883
MOSQUITTO_WS_PORT=9001
MQTT_URL="mqtt://mosquitto:1883?clientId=nestforge-api"


